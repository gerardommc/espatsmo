Package: espatsmo
Type: Package
Title: An integrated workflow for point process modelling
Version: 0.1.0
Authors@R: c(
    person(
      "Gerardo", "Martin",
      email = "gerardo.mmc@enesmerida.unam.mx",
      role = c("aut", "cre")
